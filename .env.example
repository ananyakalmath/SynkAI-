# SynkAI Application Configuration
APP_NAME=SynkAI
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
# The SvelteKit app (web/) runs on 5173 by default; 8501 (Streamlit) is kept here only
# until Streamlit is retired in Phase D.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8501", "http://127.0.0.1:8501"]

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama local inference throughput controls
# Local Ollama can only run a couple of generations at once; more than that queues
# inside Ollama and blows through the HTTP read timeout.
# OLLAMA_TIMEOUT is a stall timeout: responses are streamed, so it limits the gap
# between tokens rather than the total generation time.
OLLAMA_TIMEOUT=120
OLLAMA_MAX_DURATION=900
OLLAMA_EMBED_TIMEOUT=120
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_QUEUE_TIMEOUT=600
OLLAMA_KEEP_ALIVE=10m
OLLAMA_EMBED_KEEP_ALIVE=60s
OLLAMA_ENABLE_THINKING=False
OLLAMA_NUM_PREDICT=768

# ChromaDB Settings
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=meeting_documents

# File Upload Settings
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_MEDIA_UPLOAD_SIZE_MB=500

# Video/Audio Transcription (faster-whisper, local — no audio leaves the machine)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
FFMPEG_TIMEOUT=600

# Accounts, sessions, workspaces
DATABASE_PATH=data/synkai.db
SESSION_SECRET=
SESSION_TTL_DAYS=30
DEFAULT_WORKSPACE_NAME=Legacy Workspace
INVITE_TTL_DAYS=7
# Base URL used to build invite links — the SvelteKit app, which now owns sign-in.
FRONTEND_URL=http://localhost:5173

# Google Sign-In (OAuth 2.0 / OpenID Connect) — the same client is reused for the
# optional "Connect Google Calendar" step (Phase 3); see docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirects here with ?code=&state= — a SvelteKit route, not the app's root,
# now that sign-in lives at web/src/routes/login/google/callback/+server.ts.
GOOGLE_REDIRECT_URI=http://localhost:5173/login/google/callback
# Fernet key (44 chars, base64) that encrypts stored Google Calendar refresh tokens.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Email login codes
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RATE_LIMIT_PER_HOUR=5
EMAIL_CODE_MAX_ATTEMPTS=5

# SMTP — used for login codes now, and meeting invites/reminders from Phase 2 onward
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SynkAI <noreply@synkai.local>

# Scheduled meetings
DEFAULT_MEETING_TIMEZONE=Asia/Kolkata
REMINDER_CHECK_INTERVAL_SECONDS=300
