# SynkAI Application Configuration
APP_NAME=SynkAI
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama local inference throughput controls
# Local Ollama can only run a couple of generations at once; more than that queues
# inside Ollama and blows through the HTTP read timeout.
# OLLAMA_TIMEOUT is a stall timeout: responses are streamed, so it limits the gap
# between tokens rather than the total generation time.
OLLAMA_TIMEOUT=120
OLLAMA_MAX_DURATION=900
OLLAMA_EMBED_TIMEOUT=120
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_QUEUE_TIMEOUT=600
OLLAMA_KEEP_ALIVE=10m
OLLAMA_EMBED_KEEP_ALIVE=60s
OLLAMA_ENABLE_THINKING=False
OLLAMA_NUM_PREDICT=768

# ChromaDB Settings
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=meeting_documents

# File Upload Settings
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
