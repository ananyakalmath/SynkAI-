# Google Apps Script web app URL that receives early-access signups.
# Deploy the Apps Script project as a web app and paste its /exec URL here.
WAITLIST_URL=

# Shared secret sent with every signup request so the Apps Script endpoint
# can reject requests that didn't come from this site.
WAITLIST_SECRET=

# Base URL of the SynkAI FastAPI backend. Called only from SvelteKit server code
# (load functions, form actions, +server.ts routes) — never from the browser.
BACKEND_URL=http://localhost:8000

# Whether the session cookie requires HTTPS. Leave this at its default (true) for
# anything other than plain-HTTP local development — set to "false" only if you're
# running both this app and the backend over http:// on localhost.
SESSION_COOKIE_SECURE=true
